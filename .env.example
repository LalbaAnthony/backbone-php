# | |__  | |__) |   /  \  | \  / | |__   \ \  /\  / / |  | | |__) | ' /    | |__) | |__| | |__) |
# |  __| |  _  /   / /\ \ | |\/| |  __|   \ \/  \/ /| |  | |  _  /|  <     |  ___/|  __  |  ___/ 
# | |    | | \ \  / ____ \| |  | | |____   \  /\  / | |__| | | \ \| . \    | |    | |  | | |     
# |_|    |_|  \_\/_/    \_\_|  |_|______|   \/  \/   \____/|_|  \_\_|\_\   |_|    |_|  |_|_|     

COMPOSE_PROFILES=dev # exactly one of: dev (app-dev + pma-dev + mailpit) | prod (app-prod + pma-prod). db always starts

APP_NAME_LONG=My Website
APP_NAME_SHORT=MW
APP_NAME_URL=mywebsite.com
APP_DESCRIPTION=This is my website description.
APP_AUTHOR=Anthony Lalba
APP_VERSION=0.0.1
APP_LANG=fr
APP_ENV=development # 'development' or 'production'
APP_ROOT=/projects/backbone-php # or /var/www/html/backbone-php
APP_URL=http://localhost/projects/backbone-php
APP_ROUTING_ALLOW_METHODS=true
APP_ROUTING_ALLOW_ORIGIN=*
APP_PORT=80
APP_CPU_LIMIT=1
APP_CPU_RESERVATION=0.25
APP_MEMORY_LIMIT=1536m
APP_MEMORY_RESERVATION=512m
APP_PHP_VERSION=8.3

DB_USER=user
DB_PASSWORD=password
DB_HOST=localhost
DB_NAME=backbone-php
DB_ROOT_PASSWORD=password
# Host port for MySQL, bound to 127.0.0.1 only. Containers always use db:3306.
# Change it if a local MySQL already listens on 3306, otherwise db (and the whole stack) fails to start.
DB_PORT=3306
DB_CPU_LIMIT=0.75
DB_CPU_RESERVATION=0.25
DB_MEMORY_LIMIT=1536m
DB_MEMORY_RESERVATION=512m



PMA_CPU_LIMIT=0.25
PMA_CPU_RESERVATION=0.1
PMA_MEMORY_LIMIT=256m
PMA_MEMORY_RESERVATION=64m
PMA_PORT=8080

MAILPIT_PORT=8025
MAILPIT_CPU_LIMIT=0.25
MAILPIT_CPU_RESERVATION=0.1
MAILPIT_MEMORY_LIMIT=256m
MAILPIT_MEMORY_RESERVATION=64m

MAIL_RELAY_HOST=mailpit # outgoing SMTP relay — point to a real relay in prod
MAIL_RELAY_PORT=1025
MAIL_DOMAIN= # sender domain shown in mail headers (X-Sender), e.g. the site domain
MAIL_DEBUG_EMAIL= # all mail is redirected here when ON_LINE=false (app fallback if empty)
SMTP_ON=false # true = app sends via PHPMailer/SMTP_* instead of mail()/postfix
SMTP_HOST=
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=

